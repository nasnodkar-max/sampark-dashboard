# Copy to .env and fill in. Never commit .env.
PORT=3000

# Any random secret string you invent — Meta must send this back when you configure the webhook
WEBHOOK_VERIFY_TOKEN=change-me-to-a-random-string

# From Meta Developers dashboard → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional but recommended: App secret (Developers → Settings → Basic) enables webhook signature verification
WHATSAPP_APP_SECRET=

# Display name used in drafts and the dashboard header
REP_NAME=Arjun Deshpande

# Password gate for the politician portal (dashboard UI + API).
# The server refuses all logins until this is set — configure it on the host, never commit the real value.
DASHBOARD_PASSWORD=

# Optional: database file location (set DB_PATH on hosts with a persistent disk)
# DB_PATH=./sampark.db

# AI layer (optional — without a key, drafts/briefs fall back to built-in templates)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
